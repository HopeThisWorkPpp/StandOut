	local f = name and (FOLDER .. "/" .. name .. ".json") or accountFile()
	if fs.write then pcall(fs.write, f, HttpService:JSONEncode(Config.Values)) end
end
function Config.load(name)
	local f = name and (FOLDER .. "/" .. name .. ".json") or accountFile()
	if not (fs.exists and fs.read and fs.exists(f)) then return false end
	local ok, raw = pcall(fs.read, f); if not ok then return false end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok2 then return false end
	deepFill(data, Config.Values); Config.Values = data; getgenv().Config = data; return true
end
