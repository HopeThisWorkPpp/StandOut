-- AUTO ROLL  →  StandRoll (RemoteFunction)
-- ============================================================
local sessionStart = os.time()
coroutine.wrap(function()
    while true do
        task.wait(0.6)
        if not Config.AutoRoll then continue end
        local ok, result = pcall(function()
            -- StandRoll expects arrow type as arg
            return Remotes.StandRoll:InvokeServer(Config.ArrowType)
        end)
        if ok and result then
            local standName = type(result)=="string" and result
                or (type(result)=="table" and (result.Name or result.Stand or result[1])) or ""
            if standName ~= "" then
                -- keep legendary+
                if Config.KeepLegendaryPlus then
                    for _, kw in ipairs({"Legendary","Mythical","Godly","Unique","Secret"}) do
                        if standName:find(kw) then
                            Config.AutoRoll = false
                            Notify("Auto Roll","Got "..kw..": "..standName)
                            SendWebhook("Stand Rolled",standName.." ("..kw..")")
                            break
                        end
                    end
                end
                -- keep wanted
                for _, w in ipairs(Config.WantedStands) do
                    if standName:lower():find(w:lower()) then
                        Config.AutoRoll = false
                        Notify("Auto Roll","Got wanted: "..standName)
                        SendWebhook("Wanted Stand","Got: "..standName)
                        break
                    end
                end
            end
        end
    end
end)()

