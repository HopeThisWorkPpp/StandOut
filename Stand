-- NEARBY ALERT
local alertCooldown = 0
RunService.Heartbeat:Connect(function()
    if not Config.NearbyAlert then return end
    if os.clock() - alertCooldown < 3 then return end
    local hrp=GetHRP(); if not hrp then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p~=lp and p.Character then
            local vr=p.Character:FindFirstChild("HumanoidRootPart")
            if vr and (vr.Position-hrp.Position).Magnitude <= Config.NearbyAlertRange then
                Notify("⚠ Nearby", p.DisplayName.." is close!")
                if Config.WebhookEvents then SendWebhook("Nearby Alert", p.DisplayName.." near you") end
                alertCooldown = os.clock()
                break
            end
        end
    end
end)

