local function deepFill(target,template)
	for k,v in pairs(template) do
		if target[k]==nil then target[k]=v
		elseif type(v)=="table" and type(target[k])=="table" then deepFill(target[k],v)
		end
	end
end

local function accountFile() return FOLDER.."/acct_"..tostring(LocalPlayer.UserId)..".json" end

function Config.save(name)
	ensureFolder()
	local f=name and (FOLDER.."/"..name..".json") or accountFile()
	if fs.write then pcall(fs.write,f,HttpService:JSONEncode(Config.Values)) end
end
function Config.load(name)
	local f=name and (FOLDER.."/"..name..".json") or accountFile()
	if not (fs.exists and fs.read and fs.exists(f)) then return false end
	local ok,raw=pcall(fs.read,f); if not ok then return false end
	local ok2,data=pcall(HttpService.JSONDecode,HttpService,raw)
	if not ok2 then return false end
	deepFill(data,Config.Values); Config.Values=data; getgenv().Config=data; return true
end
function Config.delete(name)
	local f=name and (FOLDER.."/"..name..".json") or accountFile()
	if fs.delete and fs.exists and fs.exists(f) then pcall(fs.delete,f); return true end
	return false
end
function Config.list()
	if not (fs.list and fs.exists and fs.exists(FOLDER)) then return {} end
	local ok,files=pcall(fs.list,FOLDER); if not ok then return {} end
	local out={}
	for _,f in ipairs(files) do local b=f:match("([^/\\]+)%.json$"); if b then table.insert(out,b) end end
	return out
end
function Config.autoloadAll()
	if not (fs.exists and fs.read and fs.exists(ALL_FILE)) then return false end
	local ok,raw=pcall(fs.read,ALL_FILE); if not ok then return false end
	local ok2,data=pcall(HttpService.JSONDecode,HttpService,raw); if not ok2 then return false end
	deepFill(data,Config.Values); Config.Values=data; getgenv().Config=data; return true
end
function Config.autoloadPerAccount() return Config.load() end
function Config.saveAll() ensureFolder(); if fs.write then pcall(fs.write,ALL_FILE,HttpService:JSONEncode(Config.Values)) end end

local autosaveRunning=false
