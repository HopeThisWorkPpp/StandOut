local RS         = game:GetService("ReplicatedStorage")

local lp  = Players.LocalPlayer
local R   = RS:WaitForChild("Remotes")

local function GetHRP()
    local c = lp.Character or lp.CharacterAdded:Wait()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Notify(t, m)
    game:GetService("StarterGui"):SetCore("SendNotification",{Title=t,Text=m,Duration=3})
end

-- ============================================================
-- TELEPORT HELPER
-- ============================================================
local function TPTo(pos, offset)
    offset = offset or Vector3.new(0, 3, 0)
    local hrp = GetHRP()
    if hrp then
        hrp.CFrame = CFrame.new(pos + offset)
    end
end

local function TPAndWait(pos, waitTime, offset)
    TPTo(pos, offset)
    task.wait(waitTime or 0.8)
end

