-- ============================================================
-- MOB / BOSS FARM — real position-based approach
-- game spawns mobs in Workspace.Game folder
-- ============================================================
coroutine.wrap(function()
    while true do
        task.wait(0.1)
        if not Config.BossFarm and not Config.MobFarm then continue end

        local hrp = GetHRP(); if not hrp then continue end

        -- search Workspace.Game for hostile humanoids
        local Game = game:GetService("Workspace"):FindFirstChild("Game")
        if not Game then continue end

        local best, bestD = nil, math.huge
        for _, v in ipairs(Game:GetDescendants()) do
            if v:IsA("Model") and v ~= lp.Character then
                local h = v:FindFirstChildOfClass("Humanoid")
                local vr = v:FindFirstChild("HumanoidRootPart")
                if h and h.Health > 0 and vr then
                    -- filter by target name
                    if Config.MobTarget ~= "All" and not v.Name:lower():find(Config.MobTarget:lower()) then
                        continue
                    end
                    local d = (vr.Position - hrp.Position).Magnitude
                    if d < bestD then bestD = d; best = {model=v, hrp=vr, hum=h} end
                end
            end
        end

        if best then
            -- TP behind target
            local offset = best.hrp.CFrame.LookVector * -3 + Vector3.new(0, 2, 0)
            hrp.CFrame = CFrame.new(best.hrp.Position + offset)

            -- damage via CombatReturn
            if Config.InstaKill then
                best.hum.Health = 0
            else
                pcall(function()
                    local aimPos = (Config.AimAtHead and best.model:FindFirstChild("Head") or best.hrp).Position
                    R:WaitForChild("CombatReturn"):InvokeServer("HeavyAttack", best.model, aimPos)
                end)
                -- direct damage fallback
                best.hum.Health = math.max(0, best.hum.Health - 50)
            end

            -- back off on low HP
            local myHum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
            if myHum and myHum.Health < (myHum.MaxHealth * Config.BackOffHP / 100) then
                hrp.CFrame = CFrame.new(Config.FarmPosition + Vector3.new(0, 10, 0))
            end
        else
            if Config.ServerHopNoBoss then
                ServerHop()
            end
        end
    end
end)()

