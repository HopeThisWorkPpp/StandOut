local Owner={}
local _tried={}; setmetatable(_tried,{__mode="k"})
local TRY_CD=8

function Owner.getOwnerPart(p)
	if not p then return nil end
	local ok,o=pcall(function() return p:GetNetworkOwner() end)
	return ok and o or nil
end
function Owner.getOwnerModel(m)
	if not m then return nil end
	local p=m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart",true)
	return Owner.getOwnerPart(p)
end
function Owner.clientOwns(m) return Owner.getOwnerModel(m)==LocalPlayer end
function Owner.hasTried(m)
	local r=_tried[m]; if not r then return false end
	if os.clock()-r.t>TRY_CD then _tried[m]=nil; return false end; return true
end
function Owner.markTried(m) _tried[m]={t=os.clock()} end
function Owner.canInstaKill(m,ownedOnly)
	if Owner.hasTried(m) then return false end
	if ownedOnly and not Owner.clientOwns(m) then return false end
	return true
end

