local function TalkNPC(npcName)
    local npc=FindNPC(npcName)
    if not npc then return false end
    local nhrp=npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if nhrp then TPTo(nhrp.Position,2) end
    WaitFor(0.4)
    pcall(function() Rem.Dialogue:FireServer(npc) end)
    pcall(function() Rem.Dialogue:FireServer(npcName) end)
    WaitFor(0.4)
    return true
end

local function SimInteract(partName)
    local part=FindPartByName(partName)
    if part then
        local pos=part:IsA("Model") and part.PrimaryPart and part.PrimaryPart.Position
                or (part:IsA("BasePart") and part.Position)
        if pos then TPTo(pos,2); WaitFor(0.3) end
    end
    pcall(function() Rem.Quest:FireServer("Interact",partName,part) end)
    pcall(function() Rem.Quest:FireServer("Interact",partName) end)
    pcall(function() Rem.Item:FireServer("Interact",part) end)
    -- simulate H keypress
    pcall(function()
        local i=Instance.new("InputObject")
        i.KeyCode=Enum.KeyCode.H
        i.UserInputType=Enum.UserInputType.Keyboard
        i.UserInputState=Enum.UserInputState.Begin
        UserInputService.InputBegan:Fire(i,false)
    end)
    WaitFor(0.3)
end

local function EnterZone(pos)
    TPTo(pos,1); WaitFor(0.8)
    pcall(function() Rem.Quest:FireServer("Zone",tostring(pos)) end)
end

