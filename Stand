local function newHighlight(adornee,fill,outline,fillTrans,outTrans)
	local h=Instance.new("Highlight")
	h.FillColor=fill or Color3.fromRGB(255,0,0)
	h.OutlineColor=outline or Color3.fromRGB(255,255,255)
	h.FillTransparency=fillTrans or 0.5
	h.OutlineTransparency=outTrans or 0
	h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
	h.Adornee=adornee
	h.Parent=adornee
	return h
end

local function newBillboard(adornee,text,size)
	local bb=Instance.new("BillboardGui")
	bb.AlwaysOnTop=true
	bb.Size=UDim2.fromOffset(size or 100,size and size//3 or 30)
	bb.StudsOffset=Vector3.new(0,2.5,0)
	bb.Adornee=adornee
	bb.Parent=adornee
	local lbl=Instance.new("TextLabel",bb)
	lbl.BackgroundTransparency=1
	lbl.Size=UDim2.fromScale(1,1)
	lbl.TextColor3=Color3.fromRGB(255,255,255)
	lbl.TextStrokeTransparency=0
	lbl.Text=text
	lbl.TextScaled=true
	return bb,lbl
end

function ESP.clearAll()
	for _,c in ipairs(_espConns) do pcall(function() c:Disconnect() end) end
	table.clear(_espConns)
	for _,o in ipairs(_espObjs) do pcall(function() o:Destroy() end) end
	table.clear(_espObjs)
end

local function espPlayer(p)
	local cfg=Config.Values.PlayerESP
	if p==LocalPlayer and not cfg.localPlayer then return end
	if not p.Character then return end
	local char=p.Character
	local h=newHighlight(char,
		Color3.fromHex(cfg.boxTop),
		Color3.fromHex(cfg.boxBottom),
		cfg.chams and cfg.chamsTransparency or 0.5,
		cfg.boxGlow and cfg.glowTransparency or 0
	)
	table.insert(_espObjs,h)
	if cfg.name then
		local root=Util.root(char)
		if root then
			local bb,lbl=newBillboard(root,p.DisplayName)
			table.insert(_espObjs,bb)
		end
	end
end

function ESP.setPlayers(on)
	-- Remove existing player ESP
	for _,o in ipairs(_espObjs) do pcall(function() o:Destroy() end) end
	table.clear(_espObjs)
	for _,c in ipairs(_espConns) do pcall(function() c:Disconnect() end) end
	table.clear(_espConns)
	if not on then return end
	-- Tag existing players
	for _,p in ipairs(Players:GetPlayers()) do espPlayer(p) end
	-- Tag new players
	table.insert(_espConns,Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(function() task.wait(1); espPlayer(p) end)
	end))
end

local _mobESPConns={}
local _mobESPObjs={}
function ESP.setMobs(on)
	for _,c in ipairs(_mobESPConns) do pcall(function() c:Disconnect() end) end
	table.clear(_mobESPConns)
	for _,o in ipairs(_mobESPObjs) do pcall(function() o:Destroy() end) end
	table.clear(_mobESPObjs)
	if not on then return end
	local cfg=Config.Values.MobESP
	local function tag(model)
		if not model:IsA("Model") then return end
		local hum=model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health<=0 then return end
		if #cfg.onlyThese>0 then
			local ok=false
			for _,n in ipairs(cfg.onlyThese) do if model.Name==n then ok=true; break end end
			if not ok then return end
		end
		local h=newHighlight(model,Color3.fromRGB(255,120,40),Color3.fromRGB(255,255,255),0.5,0)
		h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
		table.insert(_mobESPObjs,h)
		if cfg.name then
			local root=Util.root(model)
			if root then
				local bb,_=newBillboard(root,model.Name)
				table.insert(_mobESPObjs,bb)
			end
		end
	end
	for _,v in ipairs(Workspace:GetDescendants()) do tag(v) end
	table.insert(_mobESPConns,Workspace.DescendantAdded:Connect(tag))
end

