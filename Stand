local questRunning=false
local lastQuest=""
coroutine.wrap(function()
    while true do
        task.wait(1)
        if not Config.StoryFarm then continue end
        if questRunning then continue end
        local active=GetActiveQuest(); if not active then continue end
        local handler=QuestHandlers[active]
        if handler and active~=lastQuest then
            questRunning=true
            Notify("Story Farm","Quest: "..active)
            pcall(handler)
            lastQuest=active
            questRunning=false
        elseif handler and active==lastQuest then
            -- retry same quest after delay
            task.wait(4)
            questRunning=true
            pcall(handler)
            questRunning=false
        end
    end
end)()

