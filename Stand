-- ============================================================
-- MOB / BOSS FARM LOOP
-- ============================================================
coroutine.wrap(function()
    while true do
        task.wait(0.1)
        if not (Config.BossFarm or Config.MobFarm) then continue end
        local hrp = GetHRP(); if not hrp then continue end
        local target = GetNearestMob(Config.MobTarget)
        if target then
            local thrp = target:FindFirstChild("HumanoidRootPart")
            if thrp then
                -- teleport behind mob
                hrp.CFrame = CFrame.new(thrp.Position + Config.FarmOffset)
                -- hit it
                if Config.InstaKill then
                    local h = target:FindFirstChildOfClass("Humanoid")
                    if h then h.Health = 0 end
                end
                -- back off when low hp
                local hum = GetHum()
                if hum and hum.Health < (hum.MaxHealth * Config.BackOffHP/100) then
                    hrp.CFrame = CFrame.new(Config.FarmPosition + Vector3.new(0,10,0))
                end
            end
        else
            if Config.ServerHopNoBoss then ServerHop() end
        end
    end
end)()

