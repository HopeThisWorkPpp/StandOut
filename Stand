-- MOB / BOSS FARM
-- ============================================================
coroutine.wrap(function()
    while true do
        task.wait(0.1)
        if not Config.BossFarm and not Config.MobFarm then continue end
        local hrp=GetHRP(); if not hrp then continue end
        local target=GetNearestMob(Config.MobTarget)
        if target then
            local thrp=target:FindFirstChild("HumanoidRootPart"); if not thrp then continue end
            hrp.CFrame=CFrame.new(thrp.Position+Config.FarmOffset)
            local h=target:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
                if Config.InstaKill then
                    h.Health=0
                else
                    local aimPt=(Config.AimAtHead and target:FindFirstChild("Head") or thrp).Position
                    pcall(function() Rem.MousePos:FireServer(aimPt) end)
                    pcall(function() Rem.CombatReturn:InvokeServer("HeavyAttack",target,aimPt) end)
                    h.Health=math.max(0,h.Health-50)
                end
            end
            local myH=GetHum()
            if myH and myH.Health<(myH.MaxHealth*Config.BackOffHP/100) then
                hrp.CFrame=CFrame.new(Config.FarmPosition+Vector3.new(0,10,0))
            end
        else
            if Config.ServerHopNoBoss then ServerHop() end
        end
    end
end)()

