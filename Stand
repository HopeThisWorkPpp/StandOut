local ESPFolder = Instance.new("Folder", CoreGui); ESPFolder.Name = "SO_ESP"
local ESPCache  = {}

local function MakeESPGui(adornee, color, label)
    local key = tostring(adornee)
    if ESPCache[key] and ESPCache[key].Parent then return ESPCache[key] end

    local bb = Instance.new("BillboardGui")
    bb.Name        = "ESP_"..key
    bb.Adornee     = adornee
    bb.AlwaysOnTop = true
    bb.Size        = UDim2.new(0, 6, 0, 6)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
    bb.Parent      = ESPFolder

    if Config.ESPBoxes then
        local function Bar(p,s)
            local f = Instance.new("Frame", bb)
            f.BackgroundColor3 = color; f.BorderSizePixel = 0
            f.Position = p; f.Size = s
        end
        Bar(UDim2.new(0,0,0,0),   UDim2.new(1,0,0,2))
        Bar(UDim2.new(0,0,1,-2),  UDim2.new(1,0,0,2))
        Bar(UDim2.new(0,0,0,0),   UDim2.new(0,2,1,0))
        Bar(UDim2.new(1,-2,0,0),  UDim2.new(0,2,1,0))
    end

    local lbl = Instance.new("TextLabel", bb)
    lbl.Name = "LBL"; lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(0,220,0,18); lbl.Position = UDim2.new(0.5,-110,0,-20)
    lbl.TextColor3 = color; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
    lbl.Text = label or ""; lbl.TextStrokeTransparency = 0
    lbl.TextStrokeColor3 = Color3.new(0,0,0)

    local hpOuter = Instance.new("Frame", bb)
    hpOuter.Name = "HO"; hpOuter.BackgroundColor3 = Color3.fromRGB(30,30,30)
    hpOuter.BorderSizePixel = 0; hpOuter.Position = UDim2.new(-0.25,0,0,0)
    hpOuter.Size = UDim2.new(0,4,1,0)
    local hpFill = Instance.new("Frame", hpOuter)
    hpFill.Name = "HF"; hpFill.BackgroundColor3 = Color3.fromRGB(0,200,60)
    hpFill.BorderSizePixel = 0; hpFill.AnchorPoint = Vector2.new(0,1)
    hpFill.Position = UDim2.new(0,0,1,0); hpFill.Size = UDim2.new(1,0,1,0)

    ESPCache[key] = bb
    return bb
end

local function UpdateESP(adornee, color, label, hum)
    local esp = MakeESPGui(adornee, color, label)
    local lbl = esp:FindFirstChild("LBL", true)
    if lbl then lbl.Text = label; lbl.TextColor3 = color end
    if hum then
        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local hf = esp:FindFirstChild("HF", true)
        if hf then
            hf.Size = UDim2.new(1, 0, pct, 0)
            hf.BackgroundColor3 = Color3.fromRGB(
                math.floor((1-pct)*220), math.floor(pct*180), 0)
        end
    end
end

local function KillESP(adornee)
    local k = tostring(adornee)
    if ESPCache[k] then ESPCache[k]:Destroy(); ESPCache[k] = nil end
end

RunService.Heartbeat:Connect(function()
    if not Config.PlayerESP and not Config.LocalPlayerESP then
        for k, v in pairs(ESPCache) do
            if v and v.Parent then v:Destroy() end
            ESPCache[k] = nil
        end
        return
    end

    local myHRP = GetHRP()
    local nearestPlayer = nil
    if Config.NearestOnly and myHRP then
        local bd = math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local vr = p.Character:FindFirstChild("HumanoidRootPart")
                if vr then
                    local d = (vr.Position - myHRP.Position).Magnitude
                    if d < bd then bd = d; nearestPlayer = p end
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp and not Config.LocalPlayerESP then continue end
        if Config.NearestOnly and p ~= lp and p ~= nearestPlayer then
            if p.Character then
                local vr = p.Character:FindFirstChild("HumanoidRootPart")
                if vr then KillESP(vr) end
            end
            continue
        end
        if #Config.Whitelist > 0 then
            local ok = false
            for _, n in ipairs(Config.Whitelist) do if n==p.Name then ok=true end end
            if not ok and p ~= lp then continue end
        end
        if not p.Character then continue end
        local vr  = p.Character:FindFirstChild("HumanoidRootPart")
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if not vr or not hum or hum.Health <= 0 then
            if vr then KillESP(vr) end
            continue
        end
        local color = (p == lp) and Color3.fromRGB(0,255,100) or Config.ESPColour
        local dist  = myHRP and math.floor((vr.Position-myHRP.Position).Magnitude) or 0
        local lbl   = p.DisplayName
        if Config.ESPDistance then lbl = lbl .. "  "..dist.."m" end
        if Config.FreshieTag then
            local ls = p:FindFirstChild("leaderstats")
            local lv = ls and ls:FindFirstChild("Level")
            if lv and tonumber(lv.Value) and tonumber(lv.Value) < 10 then
                lbl = "[NEW] " .. lbl
            end
        end
        UpdateESP(vr, color, lbl, hum)
    end
end)

