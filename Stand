local flyBV,flyBG
local function EnableFly()
    local hrp=GetHRP(); if not hrp then return end
    if flyBV and flyBV.Parent then return end
    flyBV=Instance.new("BodyVelocity",hrp)
    flyBV.MaxForce=Vector3.new(1e9,1e9,1e9); flyBV.Velocity=Vector3.new(0,0,0)
    flyBG=Instance.new("BodyGyro",hrp)
    flyBG.MaxTorque=Vector3.new(1e9,1e9,1e9); flyBG.P=1e4
end
local function DisableFly()
    if flyBV then flyBV:Destroy();flyBV=nil end
    if flyBG then flyBG:Destroy();flyBG=nil end
end

RunService.RenderStepped:Connect(function()
    if Config.Fly then
        EnableFly()
        local hrp=GetHRP()
        if hrp and flyBV and flyBG then
            local d=Vector3.new(0,0,0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then d=d+cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then d=d-cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then d=d-cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then d=d+cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d=d+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then d=d-Vector3.new(0,1,0) end
            flyBV.Velocity=d.Magnitude>0 and d.Unit*Config.FlySpeed or Vector3.new(0,0,0)
            flyBG.CFrame=cam.CFrame
        end
    else DisableFly() end

    local hum=GetHum()
    if hum then
        hum.WalkSpeed=Config.Speedhack and Config.WalkSpeed or 16
        if Config.NoRagdoll then
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
        end
        if Config.NoAnims then
            local anim=hum:FindFirstChildOfClass("Animator")
            if anim then for _,t in ipairs(anim:GetPlayingAnimationTracks()) do t:Stop(0) end end
        end
        if Config.AnimSpeed~=1 then
            local anim=hum:FindFirstChildOfClass("Animator")
            if anim then for _,t in ipairs(anim:GetPlayingAnimationTracks()) do t:AdjustSpeed(Config.AnimSpeed) end end
        end
    end

    if Config.Noclip then
        local c=GetChar(); if c then
            for _,p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=false end
            end
        end
    end

    local hrp=GetHRP()
    if Config.Spinbot and hrp then
        hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(Config.SpinbotSpeed),0)
    end
    if Config.AntiVoid and hrp and hrp.Position.Y<-100 then
        hrp.CFrame=CFrame.new(Config.FarmPosition+Vector3.new(0,5,0))
    end
    if Config.AntiFling and hrp and hrp.Velocity.Magnitude>500 then
        hrp.Velocity=Vector3.new(0,0,0)
    end
    if Config.LocalHeadless then
        local c=GetChar(); if c then
            local h=c:FindFirstChild("Head")
            if h then h.LocalTransparencyModifier=1
                local f=h:FindFirstChild("face")
                if f then f.LocalTransparencyModifier=1 end
            end
        end
    end

    -- visuals
    if Config.Fullbright then
        Lighting.Brightness=2; Lighting.GlobalShadows=false
