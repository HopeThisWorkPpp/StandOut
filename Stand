-- ---- 9.8  AUTO ROLL ----
-- StandRoll returns {ok=bool, stand=string, rarity=string} from InvokeServer
-- We also listen to StandStorage OnClientEvent as a fallback (game fires it on roll result)
local _lastRolledStand = nil
pcall(function()
	local RS2=game:GetService("ReplicatedStorage")
	local storage=RS2:FindFirstChild("Remotes") and RS2.Remotes:FindFirstChild("StandStorage")
	if storage and storage:IsA("RemoteEvent") then
		storage.OnClientEvent:Connect(function(action, standName, ...)
			if action=="Rolled" or action=="Obtained" or action=="Update" then
				_lastRolledStand=standName
			end
		end)
	end
end)

function Features.doAutoRoll()
	if not Config.Values.AutoRoll.enabled then return end
	local ar=Config.Values.AutoRoll
	local arrow=ar.arrowType or "Mysterious Arrow"

	-- InvokeServer returns result table directly
	_lastRolledStand=nil
	local result=Net.rollStand(arrow)
	-- Wait up to 3s for either the return value or the OnClientEvent callback
	local t0=os.clock()
	while os.clock()-t0<3 do
		if _lastRolledStand then break end
		if result and (result.stand or result.Stand) then
			_lastRolledStand=result.stand or result.Stand; break
		end
		task.wait(0.1)
	end
	-- Fallback: read from stats container
	local standName=_lastRolledStand or Game.readStat("Stand") or ""

	local rarity=Game.RARITIES[standName] or 0
	local isLeg=rarity>=Game.RARITIES.Legendary
	local isWanted=false
	for _,w in ipairs(ar.wanted or {}) do if w==standName then isWanted=true; break end end

	if Config.Values.Webhook.enabled then
		Features.webhook("Auto Roll","Got: "..standName.." (Tier "..rarity..")",
			isWanted and 0xffd700 or (isLeg and 0x9b59b6 or 0x95a5a6))
	end

	if ar.keepLegendaryPlus and isLeg then
		Util.notify("Auto Roll","Keeping "..standName.." (Legendary+)",4); return
	end
	if isWanted then
		Util.notify("Auto Roll","Got wanted stand: "..standName,5); return
	end
	-- re-roll after small delay (avoid server throttle)
	task.wait(ar.rerollDelay or 0.5)
	Features.doAutoRoll()
end

