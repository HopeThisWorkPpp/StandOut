local mobFarmRunning=false
local function nearestMob(range)
	local hrp=Util.hrp(); if not hrp then return nil end
	local best,bestDist=nil,math.huge
	for _,model in ipairs(Workspace:GetDescendants()) do
		if model:IsA("Model") and model~=LocalPlayer.Character then
			local hum=model:FindFirstChildOfClass("Humanoid")
			local root=Util.root(model)
			if hum and hum.Health>0 and root then
				local d=(root.Position-hrp.Position).Magnitude
				local pick=Config.Values.MobFarm.enemy
				if d<=range and (pick=="Any Enemy" or model.Name==pick) then
					if d<bestDist then bestDist=d; best=model end
				end
			end
		end
	end
	return best
end

function Features.setMobFarm(on)
	mobFarmRunning=on
	Util.stopLoop("MobFarm")
	if not on then return end
	Util.startLoop("MobFarm",0.5,function()
		if not Config.Values.MobFarm.enabled then return end
		-- Recovery check
		local hum=Util.hum()
		if hum and Config.Values.Recovery.enabled then
			local pct=(hum.Health/hum.MaxHealth)*100
			if pct<=Config.Values.Recovery.backOffAt then
				-- back off
				local hrp=Util.hrp()
				if hrp then
					local back=hrp.CFrame*CFrame.new(0,0,15)
					Motion.travelTo(back.Position,{timeout=3})
				end
				task.wait(1)
				return
			end
		end
		local target=nearestMob(Config.Values.MobFarm.radius)
		if not target then return end
		Motion.approach(target)
		Net.attack(target)
		if Config.Values.FarmShared.useSkills then
			-- fire skills from AutoSkills list
			for _,sk in ipairs(Config.Values.AutoSkills.skills or {}) do
				Net.useSkill(sk)
				task.wait(Config.Values.FarmShared.skillGap or 1.5)
			end
		end
	end)
end

