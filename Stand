local ESPFolder = Instance.new("Folder",CoreGui); ESPFolder.Name="ESP_SO"
local ESPCache = {}

local function MakeESP(adornee, color, label)
    local key = tostring(adornee)
    if ESPCache[key] then ESPCache[key]:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Adornee = adornee
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0,4,0,4)
    bb.StudsOffset = Vector3.new(0,3.2,0)
    bb.Parent = ESPFolder

    if Config.ESPBoxes then
        local f = Instance.new("Frame",bb)
        f.Size = UDim2.new(1,0,1,0); f.BackgroundTransparency=1; f.BorderSizePixel=0
        local function L(p,s) local x=Instance.new("Frame",f);x.BackgroundColor3=color;x.BorderSizePixel=0;x.Position=p;x.Size=s end
        L(UDim2.new(0,0,0,0),UDim2.new(1,0,0,2))
        L(UDim2.new(0,0,1,-2),UDim2.new(1,0,0,2))
        L(UDim2.new(0,0,0,0),UDim2.new(0,2,1,0))
        L(UDim2.new(1,-2,0,0),UDim2.new(0,2,1,0))
    end

    if Config.ESPNames or Config.ESPDistance then
        local lbl = Instance.new("TextLabel",bb)
        lbl.Name = "NL"; lbl.BackgroundTransparency=1
        lbl.Size = UDim2.new(0,200,0,20); lbl.Position = UDim2.new(0.5,-100,0,-22)
        lbl.TextColor3 = color; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
        lbl.Text = label or ""; lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0,0,0)
    end

    if Config.ESPHealthBars then
        local hb = Instance.new("Frame",bb)
        hb.Name="HB"; hb.BackgroundColor3=Color3.fromRGB(0,200,0)
        hb.BorderSizePixel=0; hb.Position=UDim2.new(-0.2,0,0,0); hb.Size=UDim2.new(0,4,1,0)
    end

    ESPCache[key] = bb
    return bb
end

local function KillESP(adornee)
    local k = tostring(adornee)
    if ESPCache[k] then ESPCache[k]:Destroy(); ESPCache[k]=nil end
end

-- Player ESP loop
RunService.Heartbeat:Connect(function()
    if not Config.PlayerESP then return end
    local hrp0 = GetHRP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp and not Config.LocalPlayerESP then continue end
        if not p.Character then continue end
        local vhrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not vhrp then continue end
        if Config.NearestOnly then
            local other = nil; local bd = math.huge
            for _, pp in ipairs(Players:GetPlayers()) do
                if pp ~= lp and pp.Character then
                    local vr = pp.Character:FindFirstChild("HumanoidRootPart")
                    if vr and hrp0 then
                        local d = (vr.Position-hrp0.Position).Magnitude
                        if d < bd then bd=d; other=pp end
                    end
                end
            end
            if p ~= other and p ~= lp then continue end
        end
        local color = (p==lp) and Color3.fromRGB(0,255,100) or Config.ESPColour
        local dist = hrp0 and math.floor((vhrp.Position-hrp0.Position).Magnitude) or 0
        local lbl = p.DisplayName
        if Config.ESPDistance then lbl = lbl .. "  ["..dist.."m]" end
        if Config.FreshieTag then
            local ls = p:FindFirstChild("leaderstats")
            local lvl = ls and ls:FindFirstChild("Level")
            if lvl and lvl.Value < 10 then lbl = lbl .. " 🐣" end
        end
        local esp = ESPCache[tostring(vhrp)]
        if not esp or not esp.Parent then
            MakeESP(vhrp, color, lbl)
        else
            local nl = esp:FindFirstChild("NL",true)
            if nl then nl.Text = lbl end
            -- update HP bar
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hb = esp:FindFirstChild("HB",true)
            if hb and hum then
                local pct = hum.Health / math.max(hum.MaxHealth,1)
                hb.Size = UDim2.new(0,4,pct,0)
                hb.BackgroundColor3 = Color3.fromRGB(math.floor((1-pct)*255), math.floor(pct*200), 0)
            end
        end
    end
end)

