		         autoSummon=Config.Values.FarmShared.autoSummon, useSkills=q.useSkills }
	end
	local s=Config.Values.FarmShared
	return { position=s.position, distance=s.distance,
	         x=s.offsetX, y=s.offsetY, z=s.offsetZ,
	         autoSummon=s.autoSummon, useSkills=s.useSkills }
end

function Motion.offsetFor(target,cfg)
	local hrp=Util.hrp(); if not hrp or not target then return nil end
	local flat=Vector3.new(target.X,hrp.Position.Y,target.Z)
	local dir=(flat-hrp.Position)
	dir=dir.Magnitude>0.1 and dir.Unit or hrp.CFrame.LookVector
	local base
	if cfg.position=="Above"    then base=target+Vector3.new(0,cfg.distance,0)
	elseif cfg.position=="Below"then base=target-Vector3.new(0,cfg.distance,0)
	elseif cfg.position=="Behind"then base=target-dir*cfg.distance
	else base=target+dir*cfg.distance end
	return base+Vector3.new(cfg.x,cfg.y,cfg.z)
end

function Motion.travelTo(goal,opts)
	opts=opts or {}
	local hrp=Util.hrp(); if not hrp then return false end
	local within=opts.arriveWithin or 5
	if (hrp.Position-goal).Magnitude<=within then return true end
	local spd=opts.speed or 90
	local d=(hrp.Position-goal).Magnitude
	local t=math.clamp(d/spd,0.2,6)
	local done=false
	local tw=TweenService:Create(hrp,TweenInfo.new(t,Enum.EasingStyle.Linear),{CFrame=CFrame.new(goal)})
	tw.Completed:Once(function() done=true end); tw:Play()
	local deadline=os.clock()+(opts.timeout or 12)
	while os.clock()<deadline and not done do
		local h=Util.hrp()
		if not h or (h.Position-goal).Magnitude<=within then break end
		task.wait(0.1)
	end
	pcall(function() tw:Cancel() end)
	return true
end

function Motion.approach(inst,opts)
	opts=opts or {}
	local part=Util.root(inst) or (typeof(inst)=="Instance" and inst:IsA("BasePart") and inst)
	if not part then return false end
	local cfg=Motion.settings(opts.questBlock)
	local goal=Motion.offsetFor(part.Position,cfg) or part.Position
	local ok=Motion.travelTo(goal,opts)
	if ok and cfg.autoSummon and Config.Values.SummonPilot.autoSummon then
		Net.summon()
	end
	return ok
end

local lastSummon=0
function Motion.summon(force)
	if not force and os.clock()-lastSummon<3 then return end
	lastSummon=os.clock(); Net.summon()
end

