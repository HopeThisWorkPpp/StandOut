local function getData()
	return LocalPlayer:FindFirstChild("Data")
end
local function getStats()
	local d = getData(); return d and d:FindFirstChild("Stats") or nil
end

local GameData = {}
function GameData.read(path)
	-- path is a list of child names, last is .Value
	local node = LocalPlayer
	for i, k in ipairs(path) do
		if not node then return nil end
		if i == #path then
			local child = node:FindFirstChild(k)
			if child and child:IsA("ValueBase") then
				local ok, v = pcall(function() return (child :: any).Value end)
				return ok and v or nil
			end
			-- Attribute fallback
			local ok, v = pcall(function() return node:GetAttribute(k) end)
			return ok and v or nil
		else
			node = node:FindFirstChild(k)
		end
	end
	return nil
end

function GameData.level()   return GameData.read({"Data","Stats","Level"}) end
function GameData.yen()     return GameData.read({"Data","Stats","Yen"}) or GameData.read({"Data","Stats","Coins"}) end
function GameData.stand()   return GameData.read({"Data","Stand"}) end
function GameData.skillPts()return GameData.read({"Data","Stats","SkillPoints"}) end
function GameData.inventory()
	local stats = getStats()
	local inv = stats and stats:FindFirstChild("Inventory")
	if not inv then return {} end
	local ok, t = pcall(HttpService.JSONDecode, HttpService, inv.Value or "")
	return ok and type(t) == "table" and t or {}
end
function GameData.storyProgress()
