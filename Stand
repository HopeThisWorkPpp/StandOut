-- ITEM FARM — TP to arrow spawns + interactables
-- ============================================================
local ArrowSpawnPositions = {
    Vector3.new(-319.88, 20.11, 2273.86),   -- TutorialArrowSand
    Vector3.new(-873.36, 17.12, 809.16),     -- DiamotchFloorWatch area
}

coroutine.wrap(function()
    while true do
        task.wait(1)
        if not Config.ItemFarm then continue end

        for _, pos in ipairs(ArrowSpawnPositions) do
            TPAndWait(pos, 0.5)
            pcall(function() R:WaitForChild("ArrowSupporter"):FireServer("Collect") end)
            pcall(function() R:WaitForChild("Item"):FireServer("Collect") end)
            pcall(function() R:WaitForChild("ClaimReward"):InvokeServer() end)
        end

        -- check dropped items in workspace
        local drops = game:GetService("Workspace"):FindFirstChild("Drops")
            or game:GetService("Workspace"):FindFirstChild("DroppedItems")
        if drops then
            for _, v in ipairs(drops:GetChildren()) do
                local part = v:IsA("Model") and v.PrimaryPart or (v:IsA("BasePart") and v)
                if part then
                    TPAndWait(part.Position, 0.3)
                    pcall(function() R:WaitForChild("Item"):FireServer("Collect", v) end)
                end
            end
        end
    end
end)()
