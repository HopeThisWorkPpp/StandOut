local function findNpcInWorkspace(npcName)
	for _,m in ipairs(Workspace:GetDescendants()) do
		if m:IsA("Model") and m.Name:find(npcName,1,true) then
			local root=Util.root(m)
			if root then return m end
		end
	end
	return nil
end

local function runStoryStep(stepId)
	local cfg=Config.Values.Story
	local step=STORY_STEPS[stepId]
	if not step then
		-- Unknown step — just accept quest and wait
		Net.acceptQuest(stepId)
		task.wait(3)
		return
	end

	-- Notify gates
	if step.notifyLevel then
		local lv=Game.readStat("Level") or 0
		if lv < step.notifyLevel and cfg.notifyLevel25 then
			Util.notify("Story Farm","⚠ Need Level "..step.notifyLevel.." for "..stepId,8)
			task.wait(5); return
		end
	end
	if step.notifyYacht and cfg.notifyYacht then
		Util.notify("Story Farm","🚢 Howler Yacht step: "..stepId,5)
	end

	-- Accept the quest first
	if cfg.interact then
		Net.acceptQuest(step.questId or stepId)
		task.wait(0.5)
	end

	-- Find and approach NPC
	local npcModel = findNpcInWorkspace(step.npc)
	if npcModel then
		Motion.approach(npcModel, {questBlock=true})
		task.wait(0.3)
	end

	-- Execute action
	if step.action=="talk" and cfg.talkPrompts then
		if npcModel and cfg.interact then
			Net.interact(npcModel)
			task.wait(0.5)
		end
		if cfg.autoAnswer then
			Net.talkToNpc(step.npc)
			task.wait(0.5)
		end

	elseif step.action=="dialogue" and cfg.autoAnswer then
		Net.answerDialogue({type="Howler", step=step.dialogue or "agree"})
		task.wait(0.5)

	elseif step.action=="fight" and cfg.fight then
		-- Engage mob by name, wait for kill aura to handle it
		local enemy=findNpcInWorkspace(step.npc)
		if enemy then
			Motion.approach(enemy, {questBlock=true})
			local timeout=os.clock()+30
			while os.clock()<timeout do
				local e=findNpcInWorkspace(step.npc)
				if not e then break end
				local hum=e:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health<=0 then break end
				Net.attack(e)
				task.wait(0.4)
			end
		end

	elseif step.action=="sit" and cfg.sit then
		local seat=findNpcInWorkspace(step.npc)
		if seat then
			Motion.approach(seat, {questBlock=true})
			Net.interact(seat)
			task.wait(2)
		end

	elseif step.action=="reach" and cfg.reachLocation then
		if npcModel then
			Motion.approach(npcModel, {questBlock=true})
		end
		task.wait(1)

	elseif step.action=="interact" and cfg.interact then
		if npcModel then
			Motion.approach(npcModel, {questBlock=true})
			Net.interact(npcModel)
		end
		task.wait(1)

	elseif step.action=="bobby_carry" then
		-- Bobby Carry remote
		local r=game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
		if r then
			local qr=r:FindFirstChild("Quest")
			if qr then pcall(function() qr:FireServer("Bobby Carry") end) end
		end
		task.wait(1)

	elseif step.action=="bounty_handoff" and cfg.p933Handoff then
		-- P9_33 bounty handoff at Petyr
		Net.deliverBounty("P9_33_BOUNTY")
		task.wait(1)
	end

	task.wait(0.5)
end

-- Auto-detect current story step from game's quest/progress stat
local function detectCurrentStoryStep()
	-- Method 1: StoryProgress numeric value (0-49)
	local prog=Game.readStat("StoryProgress") or Game.readStat("Story") or Game.readStat("Chapter")
	if prog and type(prog)=="number" and prog>0 then
		return math.clamp(math.floor(prog)+1, 1, 49)
	end
	-- Method 2: Current quest string matches a P9_XX pattern
	local questStr=Game.readStat("Quest") or Game.readStat("CurrentQuest") or ""
	local num=tostring(questStr):match("P9_(%d+)")
	if num then return math.clamp(tonumber(num), 1, 49) end
	-- Method 3: scan PlayerGui / LocalPlayerScripts for a progress value
	local found=nil
	pcall(function()
		for _,obj in ipairs(LocalPlayer:GetDescendants()) do
			if (obj.Name:lower():find("story") or obj.Name:lower():find("progress") or obj.Name:lower():find("chapter"))
			and (obj:IsA("IntValue") or obj:IsA("NumberValue")) then
				found=math.clamp(math.floor(obj.Value)+1,1,49); return
			end
		end
	end)
	return found
end

function Features.setStoryFarm(on)
	storyRunning=on
	if not on then return end
	task.spawn(function()
		-- Auto-resume: detect current step from game state
		local detected=detectCurrentStoryStep()
		local step = detected or (Config.Values.Story.startAt or 1)
		if detected and detected ~= (Config.Values.Story.startAt or 1) then
			Config.Values.Story.startAt=detected
			Util.notify("Story Farm","Resuming from P9_"..("%02d"):format(step),4)
		end
		while storyRunning and Config.Values.Story.enabled do
			if step>Game.STORY_TOTAL then
				Util.notify("Story Farm","All 49 parts complete!",5)
				Config.Values.Story.enabled=false
				break
			end
			local id=Game.STORY_CHAIN[step]
			pcall(runStoryStep,id)
			step=step+1
			Config.Values.Story.startAt=step
			task.wait(0.5)
		end
	end)
end

