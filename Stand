local SO={}
function SO.unload()
	Util.stopAllLoops()
	ESP.clearAll()
	Features.setFly(false)
	Features.setInfiniteJump(false)
	Features.setNoclip(false)
	Features.setKillAura(false)
	Features.setInstaKill(false)
	Features.setSpinbot(false)
	autosaveRunning=false
	storyRunning=false
	mobFarmRunning=false
	pcall(function() _window:Destroy() end)
	getgenv().StandOut=nil
end
getgenv().StandOut=SO

