-- Quest dialogue answers go through Dialogue remote for bill songs,
-- and Quest remote for howler/NPC replies
function Net.answerDialogue(opts)
	-- opts = {type="Howler"|"NPC"|"BillSongStart"|"BillSongStop", step=string, name=string}
	if not opts then return false end
	if opts.type=="Howler" then
		return Net.answerHowlerDialogue(opts.step)
	elseif opts.type=="BillSongStart" then
		local r=R("Dialogue"); if not r then return false end
		local ok,err=pcall(function() r:FireServer("BillSongStart", opts.name) end)
		if not ok then warn("[SO] Net.answerDialogue BillSongStart: "..tostring(err)) end
		return ok
	elseif opts.type=="BillSongStop" then
		local r=R("Dialogue"); if not r then return false end
		local ok,err=pcall(function() r:FireServer("BillSongStop", opts.name) end)
		if not ok then warn("[SO] Net.answerDialogue BillSongStop: "..tostring(err)) end
		return ok
	else
		-- Generic NPC talk
		return Net.talkToNpc(opts.name or "")
	end
end

