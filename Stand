local function GetChar()   return lp.Character or lp.CharacterAdded:Wait() end
local function GetHRP()    local c=GetChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHum()    local c=GetChar(); return c and c:FindFirstChildOfClass("Humanoid") end

local function Notify(t, m)
    StarterGui:SetCore("SendNotification",{Title=t,Text=m,Duration=3})
end

local function SendWebhook(title, desc)
    if Config.WebhookURL == "" then return end
    pcall(function()
        local body = HttpService:JSONEncode({
            username = "StandOut | AR-AI",
            embeds = {{
                title = title,
                description = desc,
                color = 0xff3232,
                footer = { text = os.date("%X") }
            }}
        })
        if syn and syn.request then
            syn.request({ Url=Config.WebhookURL, Method="POST",
                Headers={["Content-Type"]="application/json"}, Body=body })
        elseif http and http.request then
            http.request({ Url=Config.WebhookURL, Method="POST",
                Headers={["Content-Type"]="application/json"}, Body=body })
        end
    end)
end

local function GetNearestMob(tag)
    local hrp = GetHRP(); if not hrp then return nil end
    local best, bestD = nil, math.huge
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= lp.Character then
            local h = v:FindFirstChildOfClass("Humanoid")
            local vr = v:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and vr then
                local d = (vr.Position - hrp.Position).Magnitude
                if d < bestD then
                    if tag == "All" or v.Name:lower():find(tag:lower()) then
                        best = v; bestD = d
                    end
                end
            end
        end
    end
    return best
end

local function ServerHop()
    pcall(function()
        local data = HttpService:JSONDecode(
            game:HttpGet("https://games.roproxy.com/v1/games/"..game.PlaceId.."/servers/Public?limit=25"))
        if data and data.data then
            local pool = {}
            for _, s in ipairs(data.data) do
                if s.id ~= game.JobId and s.playing < s.maxPlayers then
                    table.insert(pool, s.id)
                end
            end
            if #pool > 0 then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, pool[math.random(1,#pool)])
                return
            end
        end
        TeleportService:Teleport(game.PlaceId)
    end)
end

