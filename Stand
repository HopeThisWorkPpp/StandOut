-- Validate that the key remotes actually exist and print their class so the
-- console confirms the Net layer is wired correctly on first inject.
task.spawn(function()
	task.wait(1)
	local root = getRemotes()
	if not root then
		warn("[SO] RS.Remotes not found — combat/quest remotes will silently fail.")
		return
	end
	local expected = { "Combat", "Quest", "Bounty", "Item", "Dialogue", "Menu", "ProjectileNetwork" }
	for _, name in ipairs(expected) do
		local r = root:FindFirstChild(name)
		if r then
			print(("[SO] Remote OK: RS.Remotes.%s  [%s]"):format(name, r.ClassName))
		else
			warn(("[SO] Remote MISSING: RS.Remotes.%s"):format(name))
		end
	end
end)
