local Net={}
local RS=game:GetService("ReplicatedStorage")
local _netCache={}

-- Resolved from combined_mods.lua: RS.Remotes is the direct child.
local function Remotes()
	if _netCache._root~=nil then return _netCache._root or nil end
	local ok,v=pcall(function()
		return RS:WaitForChild("Remotes",5)
	end)
	_netCache._root = (ok and v) or false
	return _netCache._root or nil
end

-- Cached accessor for a named child of Remotes
local function R(name)
	if _netCache[name]~=nil then return _netCache[name] or nil end
	local root=Remotes()
	if not root then _netCache[name]=false; return nil end
	local r=root:FindFirstChild(name)
	_netCache[name]=r or false
	return r or nil
end

-- Generic fire/invoke helper (kept for fallback / future remotes)
function Net.fire(remoteName,...)
	local r=R(remoteName); if not r then return false end
	local args={...}
	local ok,err=pcall(function()
		if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
			r:FireServer(table.unpack(args))
		elseif r:IsA("RemoteFunction") then
			r:InvokeServer(table.unpack(args))
		end
	end)
	if not ok then warn("[SO] Net.fire("..remoteName.."): "..tostring(err)) end
	return ok
end

function Net.interact(inst)
	if not inst then return false end
	for _,p in ipairs(inst:GetDescendants()) do
		if p:IsA("ProximityPrompt") and p.Enabled then
			local ok=pcall(function() fireproximityprompt(p) end)
			if ok then return true end
		end
	end
	return false
end

