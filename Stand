local Dialogue = Remotes.Dialogue
local Quest    = Remotes.Quest
local Item     = Remotes.Item

local function TalkToNPC(npcPos, npcName)
    TPAndWait(npcPos, 0.5)
    local npcModel = nil
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == npcName and v:IsA("Model") then
            npcModel = v; break
        end
    end
    if npcModel then
        pcall(function() Dialogue:FireServer(npcModel) end)
    else
        pcall(function() Dialogue:FireServer(npcName) end)
    end
    task.wait(0.3)
end

local function InteractWith(interactPos, interactName)
    TPAndWait(interactPos, 0.5)
    local part = nil
    local Game = Workspace:FindFirstChild("Game")
    if Game then
        local qi = Game:FindFirstChild("QuestInteractables")
        if qi then part = qi:FindFirstChild(interactName) end
    end
    if part then
        pcall(function() Item:FireServer(part) end)
        pcall(function() Quest:FireServer("Interact", part) end)
        pcall(function()
            local hrp = GetHRP()
            if hrp and part:IsA("BasePart") then
                hrp.CFrame = CFrame.new(part.Position + Vector3.new(0,2,0))
            end
        end)
    end
    task.wait(0.3)
end

local function WalkIntoZone(zonePos)
    TPAndWait(zonePos, 0.6, Vector3.new(0,1,0))
    task.wait(0.4)
end

