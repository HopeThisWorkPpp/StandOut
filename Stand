UILib.label(ct2,"▸ Network")
UILib.toggle(ct2,{"Server","networkViewer"},{
	title="Network Ownership Viewer",
	desc="Green=yours, Orange=server, Blue=other player.",
	onChange=function(on)
		if on then
			Util.startLoop("NetViewer",2,function()
				for _,p in ipairs(Workspace:GetDescendants()) do
					if p:IsA("BasePart") then
						local ok,owner=pcall(function() return p:GetNetworkOwner() end)
						if ok then
							local h=p:FindFirstChild("_SO_NetView")
							if not h then
								h=Instance.new("Highlight"); h.Name="_SO_NetView"
								h.Parent=p; h.Adornee=p
							end
							h.FillColor=owner==LocalPlayer and Color3.fromRGB(0,255,127)
								or owner==nil and Color3.fromRGB(255,170,0)
								or Color3.fromRGB(120,120,255)
							h.FillTransparency=0.85
						end
					end
				end
			end)
		else
			Util.stopLoop("NetViewer")
			for _,p in ipairs(Workspace:GetDescendants()) do
				local h=p:FindFirstChild("_SO_NetView")
				if h then h:Destroy() end
			end
		end
	end,
})

