local kaConn = nil
function Features.setKillAura(on)
	if kaConn then kaConn:Disconnect(); kaConn = nil end
	if not on then return end
	kaConn = RunService.Heartbeat:Connect(function()
		if not Config.Values.KillAura.enabled then return end
		local hrp = Util.hrp(); if not hrp then return end
		local range = Config.Values.KillAura.range
		for _, model in ipairs(Workspace:GetDescendants()) do
			if model:IsA("Model") and model ~= LocalPlayer.Character then
				local hum = model:FindFirstChildOfClass("Humanoid")
				local root = Util.root(model)
				if hum and hum.Health > 0 and root then
					if (root.Position - hrp.Position).Magnitude <= range then
						Net.attack(model)
					end
