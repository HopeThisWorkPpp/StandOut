local Net = {}
getgenv()._SO_NetCache = getgenv()._SO_NetCache or {}
local _netCache = getgenv()._SO_NetCache

-- RS.Remotes is confirmed root
local function getRemotes()
	if _netCache._root ~= nil then return _netCache._root or nil end
	local r = RS:FindFirstChild("Remotes")
	_netCache._root = r or false
	return r
end

local function getRemote(name)
	if _netCache[name] ~= nil then return _netCache[name] or nil end
	local root = getRemotes()
	if not root then _netCache[name] = false; return nil end
	local r = root:FindFirstChild(name)
	_netCache[name] = r or false
	return r
end

local function fire(remoteName, ...)
	local r = getRemote(remoteName)
	if not r then
		warn("[SO] Remote not found: " .. remoteName)
		return false
	end
	local args = { ... }
	local ok, err = pcall(function()
		if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
			r:FireServer(table.unpack(args))
		elseif r:IsA("RemoteFunction") then
			r:InvokeServer(table.unpack(args))
		end
	end)
	if not ok then warn("[SO] fire(" .. remoteName .. "): " .. tostring(err)) end
	return ok
end

