-- ============================================================

-- Restore saved values into UI controls
UILib.restore()

-- Autosave
if Config.Values.Menu.autosave then Config.setAutosave(true,120) end

-- Anti AFK always on by default
if Config.Values.Server.antiAFK then Features.setAntiAFK(true) end

-- Menu toggle key
local menuVisible=true
UserInputService.InputBegan:Connect(function(inp,processed)
	if processed then return end
	local key=Config.Values.Menu.toggleKey or "RightShift"
	if inp.KeyCode.Name==key or inp.KeyCode==Enum.KeyCode.RightShift then
		menuVisible=not menuVisible
		pcall(function()
			if menuVisible then _window:Show() else _window:Hide() end
		end)
	end
end)

-- Character re-apply loop
LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	local mv=Config.Values.Movement
	if mv.fly then Features.setFly(true) end
	if mv.speedhack then Features.setSpeed(true) end
	if mv.infiniteJump then Features.setInfiniteJump(true) end
	if mv.noclip then Features.setNoclip(true) end
	if Config.Values.Character.spinbot then Features.setSpinbot(true) end
	if Config.Values.Character.localHeadless then Features.setLocalHeadless(true) end
	Net.invalidate() -- remotes may have respawned
end)

-- Session webhook timer
local sessionStart=os.clock()
Util.startLoop("SessionReport",60,function()
	local mins=(os.clock()-sessionStart)/60
	if mins>0 and math.floor(mins)%Config.Values.Webhook.sessionReportMins==0 then
		local level=Game.readStat("Level") or "?"
		local coins=Game.readStat("Coins") or Game.readStat("Yen") or "?"
		Features.webhook("Session Report",
			("Level: %s | Coins: %s | Uptime: %s min"):format(tostring(level),tostring(coins),tostring(math.floor(mins))),
			0x5555ff
		)
	end
end)

