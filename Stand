local flyBV, flyBG

local function EnableFly()
    local hrp = GetHRP(); if not hrp then return end
    if flyBV and flyBV.Parent then return end
    flyBV = Instance.new("BodyVelocity",hrp)
    flyBV.MaxForce = Vector3.new(1e9,1e9,1e9); flyBV.Velocity = Vector3.new(0,0,0)
    flyBG = Instance.new("BodyGyro",hrp)
    flyBG.MaxTorque = Vector3.new(1e9,1e9,1e9); flyBG.P = 1e4
end

local function DisableFly()
    if flyBV then flyBV:Destroy(); flyBV=nil end
    if flyBG then flyBG:Destroy(); flyBG=nil end
end

RunService.RenderStepped:Connect(function()
    -- FLY
    if Config.Fly then
        EnableFly()
        local hrp = GetHRP()
        if hrp and flyBV and flyBG then
            local d = Vector3.new(0,0,0)
            local uis = UserInputService
            if uis:IsKeyDown(Enum.KeyCode.W) then d=d+cam.CFrame.LookVector end
            if uis:IsKeyDown(Enum.KeyCode.S) then d=d-cam.CFrame.LookVector end
            if uis:IsKeyDown(Enum.KeyCode.A) then d=d-cam.CFrame.RightVector end
            if uis:IsKeyDown(Enum.KeyCode.D) then d=d+cam.CFrame.RightVector end
            if uis:IsKeyDown(Enum.KeyCode.Space) then d=d+Vector3.new(0,1,0) end
            if uis:IsKeyDown(Enum.KeyCode.LeftControl) then d=d-Vector3.new(0,1,0) end
            flyBV.Velocity = d.Magnitude>0 and d.Unit*Config.FlySpeed or Vector3.new(0,0,0)
            flyBG.CFrame = cam.CFrame
        end
    else DisableFly() end

    -- WALKSPEED
    local hum = GetHum()
    if hum then
        if Config.Speedhack then hum.WalkSpeed = Config.WalkSpeed
        else hum.WalkSpeed = 16 end
        if Config.NoAnims then
            local anim = hum:FindFirstChildOfClass("Animator")
            if anim then for _,t in ipairs(anim:GetPlayingAnimationTracks()) do t:Stop(0) end end
        end
        if Config.AnimSpeed ~= 1 then
            local anim = hum:FindFirstChildOfClass("Animator")
            if anim then for _,t in ipairs(anim:GetPlayingAnimationTracks()) do t:AdjustSpeed(Config.AnimSpeed) end end
        end
        if Config.NoRagdoll then
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
        end
    end

    -- NOCLIP
    if Config.Noclip then
        local c=GetChar(); if c then
            for _,p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=false end
            end
        end
    end

    -- SPINBOT
    local hrp2=GetHRP()
    if Config.Spinbot and hrp2 then
        hrp2.CFrame = hrp2.CFrame * CFrame.Angles(0,math.rad(Config.SpinbotSpeed),0)
    end

    -- ANTI VOID
    if Config.AntiVoid and hrp2 and hrp2.Position.Y < -100 then
        hrp2.CFrame = CFrame.new(Config.FarmPosition+Vector3.new(0,5,0))
    end

    -- ANTI FLING
    if Config.AntiFling and hrp2 and hrp2.Velocity.Magnitude > 500 then
        hrp2.Velocity = Vector3.new(0,0,0)
    end

    -- LOCAL HEADLESS
    if Config.LocalHeadless then
        local c=GetChar()
        if c then
            local h=c:FindFirstChild("Head")
            if h then h.LocalTransparencyModifier=1
                local f=h:FindFirstChild("face")
                if f then f.LocalTransparencyModifier=1 end
            end
        end
    end

    -- VISUALS
    if Config.Fullbright then
        Lighting.Brightness=2; Lighting.GlobalShadows=false
        Lighting.Ambient=Color3.new(1,1,1); Lighting.OutdoorAmbient=Color3.new(1,1,1)
    end
    if Config.NoFog then Lighting.FogEnd=100000; Lighting.FogStart=99998 end
    if Config.NoShadows then Lighting.GlobalShadows=false end
    cam.FieldOfView = Config.CustomFOV
    if Config.InfiniteZoom then
        lp.CameraMaxZoomDistance=9999; lp.CameraMinZoomDistance=0
    end
end)

