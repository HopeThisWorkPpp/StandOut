local Util = {}

function Util.round(n, dp) local m=10^(dp or 0); return math.floor(n*m+0.5)/m end
function Util.clamp(n,lo,hi) return n<lo and lo or n>hi and hi or n end

function Util.hrp()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart") or nil
end
function Util.hum(model)
	local c = model or LocalPlayer.Character
	return c and c:FindFirstChildOfClass("Humanoid") or nil
end
function Util.root(model)
	if typeof(model)~="Instance" then return nil end
	if model:IsA("BasePart") then return model end
	local p=model:FindFirstChild("HumanoidRootPart")
	return p and p:IsA("BasePart") and p or nil
end
function Util.alive(model)
	if not model or not model.Parent then return false end
	local h=Util.hum(model); if h then return h.Health>0 end
	return Util.root(model)~=nil
end
function Util.dist(a,b)
	if typeof(a)=="Vector3" and typeof(b)=="Vector3" then return (a-b).Magnitude end
	local pa=Util.root(a); local pb=Util.root(b)
	if pa and pb then return (pa.Position-pb.Position).Magnitude end
	return math.huge
end
function Util.commas(n)
	local s=tostring(math.floor(tonumber(n) or 0))
	return (s:reverse():gsub("(%d%d%d)","% 1,"):reverse():gsub("^,",""))
end
function Util.clock(s) s=math.max(0,math.floor(s or 0)); return ("%02d:%02d"):format(s//60,s%60) end

function Util.tween(inst,info,goal,w)
	local t=TweenService:Create(inst,info,goal); t:Play()
	if w then t.Completed:Wait() end; return t
end

local _loops = {}
function Util.startLoop(name,interval,step)
	Util.stopLoop(name)
	local run=true
	task.spawn(function()
		while run do
			local ok,err=pcall(step)
			if not ok then warn("[SO] loop "..name..": "..tostring(err)) end
			task.wait(interval)
		end
	end)
	_loops[name]=function() run=false end
end
function Util.stopLoop(name)
	local s=_loops[name]; if s then s(); _loops[name]=nil end
end
function Util.stopAllLoops()
	for _,s in pairs(_loops) do s() end; table.clear(_loops)
end

function Util.notify(title,text,dur)
	pcall(function()
		if game:GetService("StarterGui").SetCore then
			game:GetService("StarterGui"):SetCore("SendNotification",{
				Title=title, Text=text, Duration=dur or 4
			})
		end
	end)
end

function Util.waitUntil(pred,timeout)
	local d=os.clock()+(timeout or 5)
	while os.clock()<d do
		if pred() then return true end
		task.wait()
	end
	return pred()
end

