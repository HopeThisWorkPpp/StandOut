local kaLastFire = 0
RunService.Heartbeat:Connect(function()
    if not Config.KillAura then return end
    if os.clock() - kaLastFire < 0.08 then return end
    kaLastFire = os.clock()

    local hrp = GetHRP(); if not hrp then return end
    local target = GetNearestMob("All")
    if not target then
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local vr = p.Character:FindFirstChild("HumanoidRootPart")
                if vr and (vr.Position-hrp.Position).Magnitude < Config.KillAuraRange then
                    local d = (vr.Position-hrp.Position).Magnitude
                    if d < bestD then bestD=d; best=p.Character end
                end
            end
        end
        target = best
    end
    if not target then return end

    local aimPart = (Config.AimAtHead and target:FindFirstChild("Head"))
                 or target:FindFirstChild("HumanoidRootPart")
    if not aimPart then return end

    pcall(function() Remotes.MousePos:FireServer(aimPart.Position) end)

    local action = Config.InstaKill and "HeavyAttack" or "LightAttack"
    pcall(function()
        Remotes.CombatReturn:InvokeServer(action, target, aimPart.Position)
    end)

    pcall(function()
        Remotes.TrainingDummyHit:FireServer(target, 9999)
    end)

    local h = target:FindFirstChildOfClass("Humanoid")
    if h and h.Health > 0 then
        h.Health = Config.InstaKill and 0 or math.max(0, h.Health - 25)
    end
end)

