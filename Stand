-- Auto Roll — uses Item remote: ("Use", arrowName, arrowId)
-- Arrow ID comes from inventory; we use nil if unknown (server resolves first valid)
function Features.doAutoRoll()
	if not Config.Values.AutoRoll.enabled then return end
	local ar = Config.Values.AutoRoll
	local arrow = ar.arrowType or "Mysterious Arrow"
	-- Use Item remote confirmed: FireServer("Use", name, id)
	-- We don't have the ID here so we use the inventory approach
	local inv = GameData.inventory()
	local arrowEntry = nil
	if type(inv) == "table" then
		for _, entry in ipairs(inv) do
			if type(entry) == "table" and entry.Name == arrow then
				arrowEntry = entry; break
			end
		end
	end
	if arrowEntry then
		Net.useItem(arrowEntry.Name, arrowEntry.ID)
	else
		-- Fallback: fire with just the name, server may still accept
		fire("Item", "Use", arrow, nil)
	end
	task.wait(2)
	local standName = GameData.stand() or ""
	local isLeg = Game.RARITIES[standName] and Game.RARITIES[standName] >= Game.RARITIES.Legendary
	local isWanted = false
	for _, w in ipairs(ar.wanted) do if w == standName then isWanted = true; break end end
	if ar.keepLegendaryPlus and isLeg then return end
	if isWanted then return end
	Features.doAutoRoll()
end

-- Auto Stats
function Features.doAutoStats()
	if not Config.Values.AutoStats.enabled then return end
	local s = Config.Values.AutoStats
	local pts = GameData.skillPts() or 0
	if pts <= 0 then return end
	local total = s.damage + s.health + s.ability
	if total == 0 then return end
	-- Stats via Quest remote: FireServer("Has", statName, amount)
	fire("Quest", "Has", "Damage", math.floor(pts * s.damage / total))
	fire("Quest", "Has", "Health",  math.floor(pts * s.health / total))
	fire("Quest", "Has", "Ability", math.floor(pts * s.ability / total))
end

-- Story Farm — uses Quest remote
-- StoryDialogue path confirmed: Quest:FireServer("StoryDialogue", path)
-- Howler replies: Quest:FireServer("Howler Dialogue Reply", pathId)
local storyRunning = false
function Features.setStoryFarm(on)
	storyRunning = on
	if not on then return end
	task.spawn(function()
		local step = Config.Values.Story.startAt or 1
		while storyRunning and Config.Values.Story.enabled do
			if step > Game.STORY_TOTAL then
				Util.notify("Story Farm", "All 49 parts complete!", 5)
				Config.Values.Story.enabled = false; break
			end
			local questId = Game.STORY_CHAIN[step]
			-- Parts 35+ use Howler Dialogue Reply for yacht segment
			if step >= Game.HOWLER_START and Config.Values.Story.howlerReplies then
				-- Find matching reply id
				for _, replyId in ipairs(Game.HOWLER_REPLIES) do
					local partNum = tonumber(replyId:match("^(%d+)_"))
					if partNum and partNum == step then
						Net.howlerDialogueReply(replyId)
						task.wait(1.5)
						break
					end
				end
			end
			-- Always fire StoryDialogue for the current quest node
			if Config.Values.Story.autoDialogue then
				Net.storyDialogue(questId)
				task.wait(1)
			end
			-- Auto fight: use Combat remote if fight step
			if Config.Values.Story.autoFight then
				local nearestEnemy = nil
				local hrp = Util.hrp()
				if hrp then
					local best, bestDist = nil, math.huge
					for _, model in ipairs(Workspace:GetDescendants()) do
						if model:IsA("Model") and model ~= LocalPlayer.Character then
							local hum = model:FindFirstChildOfClass("Humanoid")
							local root = Util.root(model)
							if hum and hum.Health > 0 and root then
								local d = (root.Position - hrp.Position).Magnitude
								if d < bestDist and d < 100 then
									bestDist = d; best = model
								end
							end
						end
					end
					nearestEnemy = best
				end
				if nearestEnemy then
					Motion.approach(nearestEnemy)
					Net.attack(nearestEnemy)
					task.wait(0.5)
				end
			end
			step = step + 1
			Config.Values.Story.startAt = step
			task.wait(2)
		end
	end)
end

-- Mob Farm
local function nearestMob(range)
	local hrp = Util.hrp(); if not hrp then return nil end
	local best, bestDist = nil, math.huge
	local pick = Config.Values.MobFarm.enemy
	for _, model in ipairs(Workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= LocalPlayer.Character then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local root = Util.root(model)
			if hum and hum.Health > 0 and root then
				local d = (root.Position - hrp.Position).Magnitude
				if d <= range and (pick == "Any Enemy" or model.Name == pick) then
					if d < bestDist then bestDist = d; best = model end
				end
			end
		end
	end
	return best
end

function Features.setMobFarm(on)
	Util.stopLoop("MobFarm")
	if not on then return end
	Util.startLoop("MobFarm", 0.5, function()
		if not Config.Values.MobFarm.enabled then return end
		local hum = Util.hum()
		if hum and Config.Values.Recovery.enabled then
			local pct = (hum.Health / hum.MaxHealth) * 100
			if pct <= Config.Values.Recovery.backOffAt then
				local hrp = Util.hrp()
				if hrp then
					Motion.travelTo((hrp.CFrame * CFrame.new(0, 0, 15)).Position, { timeout = 3 })
				end
				task.wait(1); return
			end
		end
		local target = nearestMob(Config.Values.MobFarm.radius)
		if not target then return end
		Motion.approach(target)
		Net.attack(target)
		if Config.Values.FarmShared.useSkills then
			Net.useSkill("Q") -- default skill slot; adjust as needed
			task.wait(Config.Values.FarmShared.skillGap)
		end
	end)
end

