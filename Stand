local Fluent
local function loadFluent()
	if Fluent then return Fluent end
	Fluent = getgenv().Fluent
	if not Fluent then
		local ok, err = pcall(function()
			Fluent = loadstring(game:HttpGet(
				"https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
			))()
		end)
		if not ok then error("[SO] Fluent load failed: " .. tostring(err), 0) end
		getgenv().Fluent = Fluent
	end
	return Fluent
end

local UILib = {}
local _window = nil
local _restoreQueue = {}

function UILib.init()
	loadFluent()
	-- Destroy any leftover StandOut window from a previous inject in this session
	-- so Fluent doesn't throw "You cannot create more than one window."
	if getgenv().StandOut and getgenv().StandOut._window then
		pcall(function() getgenv().StandOut._window:Destroy() end)
		getgenv().StandOut._window = nil
	end
	-- Some executors keep one global Fluent window alive; destroy it too.
	if getgenv()._FluentWindow then
		pcall(function() getgenv()._FluentWindow:Destroy() end)
		getgenv()._FluentWindow = nil
	end

	local ok, result = pcall(function()
		return Fluent:CreateWindow({
			Title    = "STAND OUT",
			SubTitle = "[TalkNova]  Place " .. tostring(game.PlaceId),
			TabWidth = 168,
			Size     = UDim2.fromOffset(680, 520),
			Theme    = "Dark",
			Acrylic  = true,
		})
	end)
	if ok and result then
		_window = result
		getgenv()._FluentWindow = _window
	else
		-- CreateWindow blocked — Fluent already has a live window we can't reach.
		-- Re-fetch it from the existing ScreenGui so tabs at least attach correctly.
		warn("[SO] CreateWindow failed (" .. tostring(result) .. ") — trying to reuse existing window.")
		local sg = game:GetService("CoreGui"):FindFirstChild("Fluent")
		           or game:GetService("Players").LocalPlayer
		                 :FindFirstChild("PlayerGui")
		                 and game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("Fluent")
		if sg then
			-- Minimal stub so AddTab calls don't explode
			_window = { AddTab = function(_, opts)
				warn("[SO] Window stub: tab '" .. tostring(opts and opts.Title) .. "' skipped.")
				local stub = {}
				setmetatable(stub, { __index = function() return function() return stub end end })
				return stub
			end, Show = function() end, Hide = function() end, Destroy = function() end }
		else
			error("[SO] Cannot create or find Fluent window. Rejoin and re-inject.", 0)
		end
	end
	return _window
end

function UILib.tab(title, icon)
	return _window:AddTab({ Title = title, Icon = icon or "" })
end

function UILib.sections(tab)
	if typeof(tab.AddLeftSection) == "function" then
		return tab:AddLeftSection(), tab:AddRightSection()
	elseif typeof(tab.AddSection) == "function" then
		return tab:AddSection(), tab:AddSection()
	end
	return tab, tab
end

local function readCfg(path)
	local c = Config.Values
	for _, k in ipairs(path) do
		if type(c) ~= "table" then return nil end; c = c[k]
	end
	return c
end
local function writeCfg(path, v)
	local c = Config.Values
	for i = 1, #path - 1 do c = c[path[i]] end
	c[path[#path]] = v
end
local function track(fn) table.insert(_restoreQueue, fn) end
function UILib.restore()
	for _, fn in ipairs(_restoreQueue) do pcall(fn) end
end

function UILib.toggle(section, path, opts)
	local h = section:AddToggle(tostring(path[#path]), {
		Title = opts.title or "", Description = opts.desc,
		Default = readCfg(path) == true,
		Callback = function(s) writeCfg(path, s); if opts.onChange then pcall(opts.onChange, s) end end,
	})
	track(function() pcall(function() h:SetValue(readCfg(path) == true) end) end)
	return h
end

function UILib.slider(section, path, opts)
	local def = readCfg(path) or opts.default or opts.min or 0
	local h = section:AddSlider(tostring(path[#path]), {
		Title = opts.title or "", Description = opts.desc,
		Min = opts.min or 0, Max = opts.max or 100, Default = def,
		Callback = function(v) writeCfg(path, v); if opts.onChange then pcall(opts.onChange, v) end end,
	})
	track(function() pcall(function() h:SetValue(readCfg(path) or def) end) end)
	return h
end

function UILib.dropdown(section, path, opts)
	local def = readCfg(path) or opts.default
	local h = section:AddDropdown(tostring(path[#path]), {
		Title = opts.title or "", Description = opts.desc,
		Values = opts.values, Multi = opts.multi == true, Default = def,
		Callback = function(v) writeCfg(path, v); if opts.onChange then pcall(opts.onChange, v) end end,
	})
	track(function() pcall(function() local s = readCfg(path); if s then h:SetValue(s) end end) end)
	return h
end

function UILib.button(section, opts)
	return section:AddButton({
		Title = opts.title or "", Description = opts.desc,
		Callback = function() if opts.onPress then pcall(opts.onPress) end end,
	})
end

function UILib.input(section, path, opts)
	local h = section:AddInput(tostring(path[#path]), {
		Title = opts.title or "", Description = opts.desc,
		Default = readCfg(path) or opts.default or "",
		Callback = function(v) writeCfg(path, v); if opts.onChange then pcall(opts.onChange, v) end end,
	})
	track(function() pcall(function() h:SetValue(readCfg(path) or "") end) end)
	return h
end

function UILib.label(section, text)
	if typeof(section.AddParagraph) == "function" then
		return section:AddParagraph(text, "")
	elseif typeof(section.AddLabel) == "function" then
		return section:AddLabel(text)
	end
	return nil
end

function UILib.readout(section, title)
	local lbl = UILib.label(section, title .. ": —")
	local function set(v)
		if lbl and typeof(lbl.SetText) == "function" then
			lbl:SetText(title .. ": " .. tostring(v))
		elseif lbl then
			pcall(function() lbl.Title = title .. ": " .. tostring(v) end)
		end
	end
	return set
end

