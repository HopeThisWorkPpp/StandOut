-- ============================================================
-- STAND FOLLOW / PILOT  →  StandFollow remote
-- ============================================================
coroutine.wrap(function()
    while true do
        task.wait(0.1)
        if Config.AutoPilot or Config.AttachStand then
            local hrp = GetHRP()
            local target = GetNearestMob("All")
            if hrp and target then
                local thrp = target:FindFirstChild("HumanoidRootPart")
                if thrp then
                    pcall(function()
                        Remotes.StandFollow:FireServer(
                            thrp.Position,          -- pilot position
                            Config.InfinitePilotRange and 9999 or nil,
                            Config.AttackWhileAttached
                        )
                    end)
                    -- also sync mouse pos for attack aim
                    if Config.AimAtHead then
                        local head = target:FindFirstChild("Head") or thrp
                        pcall(function()
                            Remotes.MousePos:FireServer(head.Position)
                        end)
                    end
                end
            end
        end
    end
end)()

-- ============================================================
-- PROJECTILE REDIRECT  →  ProjectileAim remote
-- ============================================================
coroutine.wrap(function()
    while true do
        task.wait(0.05)
        if not Config.ProjectileRedirect then continue end
        local target
        if Config.RedirectTarget == "Mobs" then
            target = GetNearestMob("All")
        else
            local best, bestD = nil, math.huge
            local hrp = GetHRP()
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    local vr = p.Character:FindFirstChild("HumanoidRootPart")
                    if vr and hrp then
                        local d = (vr.Position-hrp.Position).Magnitude
                        if d < bestD then bestD=d; best=p end
                    end
                end
            end
            target = best and best.Character
        end
        if target then
            local aimPart = (Config.AimAtHead and target:FindFirstChild("Head"))
                         or target:FindFirstChild("HumanoidRootPart")
            if aimPart then
                pcall(function()
                    Remotes.ProjectileAim:FireServer(aimPart.Position)
                end)
            end
        end
    end
end)()

