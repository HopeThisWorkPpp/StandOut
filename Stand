-- ProximityPrompt interact — preferred over remotes for NPC interaction
function Net.interact(inst)
	if not inst then return false end
	local function tryPrompt(parent)
		for _, p in ipairs(parent:GetDescendants()) do
			if p:IsA("ProximityPrompt") and p.Enabled then
				local ok = pcall(function() fireproximityprompt(p) end)
				if ok then return true end
			end
		end
		return false
	end
	if tryPrompt(inst) then return true end
	-- Fallback: try parent model
	if inst.Parent and inst.Parent:IsA("Model") then
		if tryPrompt(inst.Parent) then return true end
	end
	return false
end

function Net.invalidate()
	table.clear(_netCache)
end

