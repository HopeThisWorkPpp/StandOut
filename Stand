-- Based on real script: character:SetAttribute("Stunned",false) + humanoid.PlatformStand=false
-- + upvalue combat state table: states.Stunned=false, states.ParryStun=false
local _stunConn=nil
function Features.setNoStun(on)
	if _stunConn then _stunConn:Disconnect(); _stunConn=nil end
	Util.stopLoop("StunClear")
	if not on then return end
	local function clearStun(char)
		if not char then return end
		-- 1. attribute-based stun (what the real script clears)
		pcall(function() char:SetAttribute("Stunned", false) end)
		-- 2. humanoid PlatformStand
		local hum=char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function() hum.PlatformStand=false end)
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
		end
		-- 3. any BoolValue/NumberValue named Stun
		for _,v in ipairs(char:GetDescendants()) do
			if v.Name:lower():find("stun") and (v:IsA("BoolValue") or v:IsA("NumberValue")) then
				pcall(function() v.Value=v:IsA("BoolValue") and false or 0 end)
			end
		end
	end
	-- Poll every 0.15s — same cadence the real script uses
	Util.startLoop("StunClear",0.15,function()
		if not Config.Values.Dash.noStun then return end
		clearStun(LocalPlayer.Character)
	end)
	_stunConn=LocalPlayer.CharacterAdded:Connect(function(char) clearStun(char) end)
end

local _ragdollConn=nil
function Features.setNoRagdoll(on)
	if _ragdollConn then _ragdollConn:Disconnect(); _ragdollConn=nil end
	Util.stopLoop("RagdollClear")
	if not on then return end
	local function patchChar(char)
		local hum=char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		hum.StateChanged:Connect(function(_old,new)
			if not Config.Values.Dash.noRagdoll then return end
			if new==Enum.HumanoidStateType.Ragdoll or new==Enum.HumanoidStateType.FallingDown then
				task.defer(function()
					pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
					pcall(function() char:SetAttribute("Stunned",false) end)
					pcall(function() hum.PlatformStand=false end)
				end)
			end
		end)
	end
	local char=LocalPlayer.Character; if char then patchChar(char) end
	_ragdollConn=LocalPlayer.CharacterAdded:Connect(patchChar)
end

