local function deepFill(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then target[k] = v
		elseif type(v) == "table" and type(target[k]) == "table" then deepFill(target[k], v)
		end
	end
end
local function accountFile()
	return FOLDER .. "/acct_" .. tostring(LocalPlayer.UserId) .. ".json"
