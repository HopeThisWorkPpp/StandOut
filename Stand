		Features.webhook(
			"Session Report",
			("Level: %s | Yen: %s | Stand: %s | Uptime: %d min"):format(
				tostring(level), tostring(yen), tostring(stand), math.floor(mins)
			),
			0x5555ff
		)
	end
end)

