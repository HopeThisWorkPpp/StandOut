local _mobESPConns = {}
local _mobESPObjs  = {}
function ESP.setMobs(on)
	for _, c in ipairs(_mobESPConns) do pcall(function() c:Disconnect() end) end
	table.clear(_mobESPConns)
	for _, o in ipairs(_mobESPObjs) do pcall(function() o:Destroy() end) end
	table.clear(_mobESPObjs)
	if not on then return end
	local cfg = Config.Values.MobESP
	local function tag(model)
		if not model:IsA("Model") then return end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		if #cfg.onlyThese > 0 then
			local ok = false
			for _, n in ipairs(cfg.onlyThese) do if model.Name == n then ok = true; break end end
			if not ok then return end
		end
		local h = newHighlight(model, Color3.fromRGB(255, 120, 40), Color3.fromRGB(255, 255, 255), 0.5, 0)
		table.insert(_mobESPObjs, h)
		if cfg.name then
			local root = Util.root(model)
			if root then local bb, _ = newBillboard(root, model.Name); table.insert(_mobESPObjs, bb) end
		end
	end
	for _, v in ipairs(Workspace:GetDescendants()) do tag(v) end
	table.insert(_mobESPConns, Workspace.DescendantAdded:Connect(tag))
end

