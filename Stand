-- Based on real script: reads player.Data.Skills.Skill{N}, checks OnCooldown/InUse attrs
-- then fires native combat.useSkill OR presses the keybind
local _skillSlot=0
function Features.useNextSkill()
	local char=LocalPlayer.Character; if not char then return false end
	local data=LocalPlayer:FindFirstChild("Data")
	local folder=data and data:FindFirstChild("Skills")
	if not folder then return Net.useSkill("BloodDrainAim") end
	local slots={}
	for i=0,10 do
		local node=folder:FindFirstChild("Skill"..i)
		if node and node.Value and node.Value~="" then
			local onCD=node:GetAttribute("OnCooldown") or node:GetAttribute("InUse")
			if not onCD then table.insert(slots,{index=i,name=node.Value}) end
		end
	end
	if #slots==0 then return false end
	_skillSlot=_skillSlot%#slots+1
	local slot=slots[_skillSlot]
	-- Try combat remote first, then keybind fallback
	local keybinds={[0]=Enum.KeyCode.Zero,Enum.KeyCode.One,Enum.KeyCode.Two,
		Enum.KeyCode.Three,Enum.KeyCode.Four,Enum.KeyCode.Five,
		Enum.KeyCode.Six,Enum.KeyCode.Seven,Enum.KeyCode.Eight,Enum.KeyCode.Nine}
	local target=nil
	-- find nearest enemy
	local hrp=Util.hrp()
	if hrp then
		local gameFolder=Workspace:FindFirstChild("Game")
		local npcFolder=gameFolder and gameFolder:FindFirstChild("NPCs")
		local range=Config.Values.AutoSkills.enemyRange or 30
		local best,bestDist=nil,math.huge
		for _,model in ipairs(npcFolder and npcFolder:GetChildren() or {}) do
			if model:IsA("Model") and model:GetAttribute("FightableNPC")==true
				and not model:GetAttribute("PassedOut") then
				local root=Util.root(model)
				local hum=model:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health>0 then
					local d=(root.Position-hrp.Position).Magnitude
					if d<bestDist and d<=range then bestDist=d; best=model end
				end
			end
		end
		target=best
	end
	Net.useSkill("Skill"..slot.index, target)
	return true
end

